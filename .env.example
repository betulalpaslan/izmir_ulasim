# Bu dosyayı .env olarak kopyalayıp değerleri doldurun (.env git'e girmez).

# Google Maps Android SDK anahtarı — react-native-maps Android'de bunu kullanır.
# https://console.cloud.google.com/apis/credentials
# Anahtarı mutlaka kısıtlayın: Application restrictions → Android apps
#   Paket adı: com.izmirulasim.app
#   SHA-1: `eas credentials` veya `keytool -list -v -keystore ...` ile alınır
# API restrictions → yalnızca "Maps SDK for Android"
GOOGLE_MAPS_API_KEY=

# Rota/otopark/BİSİM verilerini sağlayan backend (Railway).
# Boş bırakılırsa Services/routeService.js varsayılan adresi kullanır.
# Backend'i makinede çalıştırırsanız: Android emülatörü http://10.0.2.2:3000,
# fiziksel telefon http://<makinenin-LAN-IP'si>:3000 (aynı Wi-Fi gerekir).
EXPO_PUBLIC_API_URL=https://izmirbackend-production.up.railway.app
